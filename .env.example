# Порт HTTP-сервера
PORT=1616

# Пароль администратора (обязателен для входа в /admin)
ADMIN_PASSWORD=change-me

# Секрет для подписи cookie сессий (сгенерируйте случайную строку)
SESSION_SECRET=

# Каталог с JSON-данными
DATA_DIR=data

# Базовые URL для OG-тегов и ссылок «поделиться»
PUBLIC_BASE_URL=https://release.hpsbassline.club
SHARE_BASE_URL=https://rls.hpsbassline.club
